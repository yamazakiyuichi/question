<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.medquiz.ui.home.HomeFragment"
        android:label="ホーム">
        <action
            android:id="@+id/action_homeFragment_to_quizFragment"
            app:destination="@id/quizFragment"/>
    </fragment>

    <fragment
        android:id="@+id/quizFragment"
        android:name="com.example.medquiz.ui.quiz.QuizFragment"
        android:label="クイズ">
        <argument android:name="year" app:argType="string" android:defaultValue=""/>
        <argument android:name="category" app:argType="string" android:defaultValue=""/>
        <argument android:name="mode" app:argType="string" android:defaultValue="all"/>
        <action
            android:id="@+id/action_quizFragment_to_resultFragment"
            app:destination="@id/resultFragment"/>
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.medquiz.ui.result.ResultFragment"
        android:label="結果">
        <argument android:name="correct" app:argType="integer" android:defaultValue="0"/>
        <argument android:name="total" app:argType="integer" android:defaultValue="0"/>
        <action
            android:id="@+id/action_resultFragment_to_quizFragment"
            app:destination="@id/quizFragment"/>
    </fragment>

    <fragment
        android:id="@+id/reviewFragment"
        android:name="com.example.medquiz.ui.review.ReviewFragment"
        android:label="間違えた問題"/>

</navigation>
